# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# MicroBench specific
# LLM API keys (NEVER commit)
.env

# Local debug / smoke test artifacts (repository ROOT only — the same
# pattern inside microbench/ would hide microbench/_test_regressions.py,
# which is a real regression suite and belongs in version control)
_/_test_*.py
/_test_webview.py
_/_debug_*.py
_/_smoke_*.py
_/_v*_smoke*.py
_/_liu_*.py
/_clean_*.py

# Vault contents (user actual notes/literature) — keep on disk only
00_Dashboard/
01_Literature/
02_Reproduction/
03_Knowledge/
04_Weekly_Reports/
_Templates/
.obsidian/

# Generated audit/scratch artifacts (not source)
_/_*.txt
/_audit_*.md
/_*.log

# Audit report produced by security-audit skill (kept locally, never in repo)
AUDIT_REPORT.md

# Runtime artifacts. app.py's snapshot code claims logs/

# Backup copies of the launcher (kept on disk, never in the repo)
start_workbench.bat.bak is gitignored so
# translated paper text never leaks into the public Obsidian vault — it was
# not actually ignored, so a `git add -A` would have committed them.
logs/

# Backup copies of the launcher (kept on disk, never in the repo)
start_workbench.bat.bak
