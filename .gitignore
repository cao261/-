# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# MicroBench specific
# LLM API keys (NEVER commit)
.env

# Local debug / smoke test artifacts (repository ROOT only — the same
# pattern inside microbench/ would hide microbench/_test_regressions.py,
# which is a real regression suite and belongs in version control)
_/_test_*.py
/_test_webview.py
_/_debug_*.py
_/_smoke_*.py
_/_v*_smoke*.py
_/_liu_*.py
/_clean_*.py

# Vendored KaTeX dist (rebuild with:
#   npm install katex --prefix microbench/_vendor --registry=https://registry.npmmirror.com)
microbench/_vendor/

# Generated offline bundle — a build artifact, not source
MicroBench_离线阅读版.html
MicroBench_平板工作台.html

# Vault contents (user actual notes/literature) — keep on disk only
00_Dashboard/
01_Literature/
02_Reproduction/
03_Knowledge/
04_Weekly_Reports/
_Templates/
.obsidian/

# Generated audit/scratch artifacts (not source)
# NOTE: these patterns are anchored to the repo ROOT on purpose. The
# unanchored `_*.py` form would also match microbench/_test_lan.py,
# microbench/_e2e_lan.py and microbench/_test_offline_export.py -- real
# regression suites that must stay in version control.
# (Root-anchored `/_*.py` is safe: it only matches files at the repo root,
#  never microbench/_test_*.py.)
/_*.py
/_*.txt
/_audit_*.md
/_*.md
/_*.log
/_*.ps1

# Audit report produced by security-audit skill (kept locally, never in repo)
AUDIT_REPORT.md

# Runtime artifacts -- logs/ holds uvicorn.log, offline_export.log and
# translated paper text, none of which may leak into the public Obsidian vault
logs/

# Backup copies of the launcher (kept on disk, never in the repo)
start_workbench.bat.bak
