# MicroBench LLM 配置示例
# 复制本文件为 .env 并填入你的实际配置, .env 不会被 git 追踪

# ===== 主模型配置 (Primary: 默认首选, 如 MiniMax-M2.7) =====
# MiniMax 具备高精学术能力, 但受 5 小时 Token Plan 额度限制
LLM_API_KEY=
LLM_BASE_URL=https://api.minimax.chat/v1
LLM_MODEL_NAME=MiniMax-M2.7

# ===== 降级备用模型配置 (Fallback: 如 Agnes 3.0 Flash) =====
# 当主模型 5 小时额度耗尽 (429 报错) 时，系统自动无缝降格到 Agnes
# Agnes 3.0 Flash 具备 1M 超大上下文与无限免费额度，受 20 RPM 速率保护
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL_NAME=agnes-3.0-flash

# 当 MiniMax 额度恢复后，系统探针会自动检测并升格回 MiniMax-M2.7