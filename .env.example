# MicroBench LLM 配置示例
# 复制本文件为 .env 并填入你的实际配置, .env 不会被 git 追踪
#
# [密钥获取]
#   MiniMax 开放平台 (国内) https://platform.minimaxi.com
#   账户管理 -> 接口密钥 -> 创建新的密钥 -> 复制
#
# [区域必须匹配]
#   国内站 key -> api.minimaxi.com (注意结尾多一个 i)
#   国际站 key -> api.minimax.io
#
# [可选模型清单]
#   MiniMax-M3 / MiniMax-M3.1-Flash / MiniMax-M2.7 / MiniMax-M2.7-highspeed ...
#   GET https://api.minimaxi.com/v1/models 可列出账号可用的全部模型

# ===== 主模型配置 (Primary) =====
# 读论文 / 解读 / 答疑用这个模型（可以要推理）。
LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL_NAME=MiniMax-M3

# ===== 翻译专用模型（可选）=====
# 批量直译单独用一个模型：M3.1-Flash 强制开启思考模式（thinking.type=disabled
# 直接 400），实测整页 2766 字符要 40~250s，而且推理会把输出预算吃光、正文
# 被截断；M3 能关思考，同一页 10s 出完整译文。
# 留空 = 翻译跟随上面的主模型。
LLM_TRANSLATION_MODEL=MiniMax-M3

# 翻译任务是否关闭思考模式 (1=关闭, 0=沿用模型默认)
# 直译属于"不需要推理"的任务，关掉思考更快也更稳。
# MiniMax-M3 支持 thinking.type=disabled；M3.1-Flash 不支持，代码会自动忽略
# 并给这类模型自动加大输出预算。
LLM_TRANSLATION_DISABLE_THINKING=1

# ===== 降级备用模型配置 (Fallback: Agnes 3.0 Flash) =====
# 当主模型 5 小时额度耗尽 (429 报错) 时，系统自动无缝降格到 Agnes
# Agnes 3.0 Flash 具备 1M 超大上下文与无限免费额度，受 20 RPM 速率保护
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL_NAME=agnes-3.0-flash

# 当 MiniMax 额度恢复后，系统探针会自动检测并升格回主模型
